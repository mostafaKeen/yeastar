APP_NAME="Yeastar Bitrix24 Integration"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://yeastar.keenenter.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Database (Internal Docker network)
DB_CONNECTION=mysql
DB_HOST=yeastar-db
DB_PORT=3306
DB_DATABASE=yeastar_production
DB_USERNAME=yeastar_user
DB_PASSWORD=YeastarSecurePass2026!

# Session, Cache & Queue (Redis 7)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=yeastar_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=yeastar-redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# Bitrix24 Marketplace App Credentials
BITRIX24_CLIENT_ID=app.your_client_id_here
BITRIX24_CLIENT_SECRET=your_client_secret_here

# Telephony Platform Settings
TELEPHONY_WEBHOOK_TIMEOUT=15
TELEPHONY_RECORDING_TIMEOUT=120
TELEPHONY_MEDIA_STREAM_CHUNK_KB=64

# Platform Egress IPs (VPS Public IP: 129.121.87.221)
PLATFORM_EGRESS_IPS=129.121.87.221
